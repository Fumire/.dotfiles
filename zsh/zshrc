stty -ixon

# choose theme
if [[ -n "$SSH_CONNECTION" ]]; then
    ZSH_THEME="remote"
else
    ZSH_THEME="local"
fi

# Soure oh-my-zsh *after* THEME
zstyle ':omz:alpha:lib:git' async-prompt no
if [[ -d ${ZDOTDIR:-$HOME}/.oh-my-zsh ]]; then
    export ZSH=${ZDOTDIR:-$HOME}/.oh-my-zsh
    source ${ZSH}/oh-my-zsh.sh
fi

# plugins
plugins=(
    git
    vi-mode
    zsh-syntax-highlighting
    ssh-agent
)

# editors
_path_prepend_once() {
    local entry="$1"
    if [[ ":${PATH}:" != *":${entry}:"* ]]; then
        PATH="${entry}:${PATH}"
    fi
}

if [[ $(uname) == "Darwin" ]]; then
    export EDITOR=$(which nvim)
    export VISUAL=$(which nvim)

    _path_prepend_once /usr/local/sbin
    _path_prepend_once /opt/homebrew/sbin
    _path_prepend_once /opt/homebrew/bin
    export PATH
else
    export EDITOR=$(which vim)
    export VISUAL=$(which vim)
fi
export PAGER=$(which less)

if [[ -z "$TERM" ]]; then
    export TERM="xterm-256color"
fi

# ssh
_ssh_dir="${ZDOTDIR:-$HOME}/.ssh"
for _ssh_key in id_rsa id_ed25519 ecdsa; do
    if [[ -f "${_ssh_dir}/${_ssh_key}" ]]; then
        export SSH_KEY_PATH="${_ssh_dir}/${_ssh_key}"
        break
    fi
done
unset _ssh_dir _ssh_key
zstyle :omz:plugins:ssh-agent identities id_rsa id_ed25519 ecdsa

# locale setting
if [[ -z "$LC_ALL" ]]; then
    export LC_ALL="en_US.UTF-8"
fi
if [[ -z "$LANG" ]]; then
    export LANG="en_US.UTF-8"
fi

# alias
if [[ -f "${ZDOTDIR:-$HOME}/.alias.zsh" ]]; then
    source ${ZDOTDIR:-$HOME}/.alias.zsh
fi

# multiple line command
autoload -U edit-command-line
zle -N edit-command-line
bindkey "^xe" edit-command-line
bindkey "^x^e" edit-command-line

# PATH settings
_path_prepend_once "${ZDOTDIR:-$HOME}/.local/bin"
_path_prepend_once "${ZDOTDIR:-$HOME}/go/bin"
export PATH
unfunction _path_prepend_once

# gpg settings
export GPG_TTY=$(tty)

# Slurm settings
export SQUEUE_FORMAT='%.9i %.20j %.9u %.8T %.9M %.3C %.9m %.20V %.20S %R'

# X11 settings
export _JAVA_OPTIONS='-Dawt.useSystemAAFontSettings=on -Dswing.aatext=true -Dsun.java2d.xrender=true'
export JAVA_OPTIONS='-Dawt.useSystemAAFontSettings=on -Dswing.aatext=true -Dsun.java2d.xrender=true'

# Venv settings
export VIRTUAL_ENV_DISABLE_PROMPT=

# git status
__git_prompt_git () {
    GIT_OPTIONAL_LOCKS=0 command timeout 1.0s git "$@"
}

# Generate a UUID from an operating-system random source
uuid () {
    local uuid_value

    if command -v uuidgen > /dev/null 2>&1; then
        uuid_value=$(command uuidgen) || return
    elif [[ -r /proc/sys/kernel/random/uuid ]]; then
        IFS= read -r uuid_value < /proc/sys/kernel/random/uuid || return
    else
        printf '%s\n' 'uuid: uuidgen or /proc/sys/kernel/random/uuid is required' >&2
        return 127
    fi

    printf '%s\n' "${uuid_value:l}"
}

# Brew setting
if [[ $(uname) == "Darwin" ]]; then
    eval "$(brew shellenv)"
fi
